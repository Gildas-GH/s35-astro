---
import type { Page } from '@/i18n/types';
import Datetime from './Datetime.astro';

interface Props {
  wp_url: string;
}

const { wp_url } = Astro.props;

const request = await fetch(`${wp_url}/wp-json/wp/v2/posts?per_page=6&_embed`);
const pages: Page[] = await request.json();

---

<ul class="my-4">
  {pages.map((p) => 
    <li class="my-6">
      <a
        href={p.link} target="_blank"
        class:list={[
          "text-accent inline-block text-lg font-medium",
          "decoration-dashed underline-offset-4 hover:underline",
          "focus-visible:no-underline focus-visible:underline-offset-0",
        ]}
      >
        <h3>
          {p.title.rendered}
        </h3>
      </a>
      <Datetime pubDatetime={new Date(p.date)} />
      <p set:html={p.excerpt.rendered}></p>
    </li>
  )}
</ul>
