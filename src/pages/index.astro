---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { useTranslations } from "@/i18n";
import config from "@/config";
import PostsWP from "@/components/PostsWP.astro";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");

---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
  >
    <section id="hero" class="pt-8 bg-accent text-center text-white herolidaires relative mb-24">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        Solidaires 35
      </h1>
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block ml-2"
        aria-label="RSS Feed"
        title="RSS Feed"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-white scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS Feed</span>
      </a>

      <p class="max-w-app mx-auto">
        Solidaires est un syndicat qui défend toutes et tous les travailleur·euses. 
        Solidaires est un syndicat de lutte et de transformation sociale, indépendant, 
        et implanté dans tous les secteurs privés comme publics. Solidaires est présent
        en Ille-et-Vilaine avec l'Union Départementale Solidaires 35.
      </p>
      <p class="mt-2">
        Retrouvez toutes nos mobilisations sur{" "}
        <LinkButton
          class="underline decoration-dashed underline-offset-4 hover:text-border"
          href="https://www.solidaires.org"
        >
          solidaires.org
        </LinkButton>{" "}
        pour plus d'informations.
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center justify-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-12 pb-6 app-layout">
          <h2 class="text-2xl font-bold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center app-layout">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>

    <div class="my-8 text-center app-layout">
      <div class="bg-accent border-4 border-accent text-white">
        <h2 class="text-xl py-4">Solidaires 35 sur Instagram</h2>
        <iframe class="aspect-square w-full" src="https://www.instagram.com/solidaires_35/embed/"></iframe>
      </div>
    </div>

    <section id="recent-posts" class="pt-12 pb-6 app-layout">
      <div class="flex justify-between">
        <h2 class="text-2xl font-bold tracking-wide">
          Mobilisations nationales
        </h2>
        <a href="https://www.solidaires.org" target="_blank" class="font-mono">solidaires.org</a>
      </div>
      <PostsWP wp_url="https://www.solidaires.org" />
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

<style>
  .herolidaires::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -100px;
    height: 100px;
    background-image: url('/border.png');
    background-repeat: repeat round;
    background-position: bottom center;
    pointer-events: none;
  }
</style>