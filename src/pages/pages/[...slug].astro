---
import { render, getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
import Formations from "@/components/Formations.astro";
import IconDownload from "@/assets/icons/IconDownload.svg";
import { fr } from 'chrono-node';

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({
    params: { slug: page.id },
    props: {
      page,
    }
  }));
}

function prochainJourDuMois(text: string, from = new Date()) {
  const jours: Record<string, number> = {
    dimanche: 0,
    lundi: 1,
    mardi: 2,
    mercredi: 3,
    jeudi: 4,
    vendredi: 5,
    samedi: 6,
  };

  const ordinaux: Record<string, number> = {
    'premier': 1,
    'première': 1,
    '1er': 1,
    '1re': 1,
    'deuxième': 2,
    'deuxieme': 2,
    'second': 2,
    'seconde': 2,
    '2e': 2,
    'troisième': 3,
    'troisieme': 3,
    '3e': 3,
    'quatrième': 4,
    'quatrieme': 4,
    '4e': 4,
    'cinquième': 5,
    'cinquieme': 5,
    '5e': 5,
  };

  const regex =
    /(?:le\s+)?(premier|première|1er|1re|deuxième|deuxieme|second|seconde|2e|troisième|troisieme|3e|quatrième|quatrieme|4e|cinquième|cinquieme|5e)\s+(dimanche|lundi|mardi|mercredi|jeudi|vendredi|samedi)\s+du\s+mois/i;

  const match = text.match(regex);

  if (!match) {
    return new Date(0)
  }

  const [, ordinalText, jourText] = match;

  const occurrence = ordinaux[ordinalText.toLowerCase()];
  const jour = jours[jourText.toLowerCase()];

  // Cherche l'occurrence dans le mois donné
  function trouver(year: number, month: number) {
    const premier = new Date(year, month, 1);
    const decalage = (jour - premier.getDay() + 7) % 7;

    return new Date(
      year,
      month,
      1 + decalage + (occurrence - 1) * 7
    );
  }

  // On commence par le mois courant
  let date = trouver(from.getFullYear(), from.getMonth());

  // Si la date est passée, on prend le mois suivant
  if (date < from) {
    date = trouver(from.getFullYear(), from.getMonth() + 1);
  }

  return date;
}

const { page } = Astro.props;

const { Content } = await render(page);

let nextPerm: Date[] = []
let nextPermStr: string[] = []
if (page.data.permanences) {
  nextPerm = page.data.permanences.map((perm) => prochainJourDuMois(perm));
  nextPerm.sort((a, b) => a.getTime() - b.getTime());
  nextPermStr = nextPerm.map((perm) => perm.toLocaleDateString("fr-FR", {
    day: "numeric",
    month: "long"
  }));
}

---

<Layout
  title={`${page.data.title} | ${config.site.title}`}
  description={page.data.description}
  ogImage={page.data.image}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={page.data.title} class="app-prose">
    {
      page.data?.image && <img src={page.data.image} />
    }
    <Content />
    {
      nextPerm?.length > 0 &&
      <h2 class="bg-accent p-4 text-center text-white">Prochaines permanences le {nextPermStr.map((perm, index) => <span>{perm}{index < nextPerm.length-1 && ", le "}</span>)} </h2>
    }
  </Main>

  {
    page.data.formation && <Formations />
  }
  {
    page.data.map?.latitude &&
    <div class="app-layout flex border-accent border-4 px-0">
      <div class="flex-1">
        <iframe height="350" width="100%" src={`https://www.openstreetmap.org/export/embed?bbox=-1.8499946594238283,48.068788220302196,-1.5633201599121094,48.17650327923257&layer=mapnik&marker=${page.data.map.latitude},${page.data.map.longitude}`} style="border: 0px"></iframe>
      </div>
      <div class="flex-1 bg-accent text-white flex flex-col justify-between p-6">
        <div class="flex flex-col gap-2">
          <h2 class="text-4xl">{page.data.map.address}</h2>
          <p>Métro : {page.data.map.transit}</p>
          <p>Parking à proximité</p>
        </div>
        <div class="flex justify-between">
          <a class="border-white border-2 hover:bg-white hover:text-accent py-1 px-2" href={`geo:${page.data.map.latitude},${page.data.map.longitude}`}>Ouvrir dans un GPS</a>
          <a class="border-white border-2 hover:bg-white hover:text-accent py-1 px-2" href={`https://www.openstreetmap.org/?mlat=${page.data.map.latitude}&mlon=${page.data.map.longitude}#map=13/${page.data.map.latitude}/${page.data.map.longitude}`} target="_blank">Ouvrir la carte</a>
        </div>
      </div>
    </div>
  }

  {
    page.data?.embed && <div class="max-w-app w-full" set:html={page.data.embed} />
  }
  {
    (page.data.documents && page.data.documents?.length > 0) &&
    <div class="app-prose app-layout mb-8">
      <h2>Documents associés</h2>
      {
        page.data.documents.map(doc => {
          var filename = doc.split('/').pop()
          return (
            <a href={doc} download class="flex items-center gap-2">
              <IconDownload /> {filename}
            </a>
          );
        })
      }
    </div>
  }

  <Footer />
</Layout>
