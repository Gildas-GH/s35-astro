---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const pages = await getCollection("pages");

---

<Layout title={`Pages | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="Pages" pageDesc="Pages du site Solidaires 35 exportées de WordPress (donc désynchronisées)">
    <div class="grid grid-cols-3 gap-4 my-4">
      {pages.map((p) => 
        <a href={`/pages/${p.id}/`} class="border-accent border-4 text-accent hover:text-white hover:bg-accent transition font-bold flex items-center text-center p-4">
          <h3>{p.data.title}</h3>
        </a>
      )}
    </div>

  </Main>

  <Footer />
</Layout>
