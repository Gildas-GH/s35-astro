---
import Breadcrumb from '@/components/Breadcrumb.astro';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import Layout from '@/layouts/Layout.astro';
import config from "@/config";
import Main from "@/components/Main.astro";
import type { Page } from '@/i18n/types';

const request = await fetch("https://solidaires35.fr/wp-json/wp/v2/posts?per_post=100&_embed");
const posts: Page[] = await request.json();

---

<Layout
  title={`posts | ${config.site.title}`}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={"posts"} class="app-prose">
    <p>Liste des posts WordPress : </p>
    <div class="flex flex-col gap-5">
        {posts.map((p) => 
        <a href={`/posts/${p.slug}/`}>
            <div>
                {
                    p._embedded['wp:featuredmedia']?.[0] &&
                    <img src={p._embedded['wp:featuredmedia']?.[0]?.source_url} alt={p._embedded['wp:featuredmedia']?.[0]?.title.rendered} />
                }
                {p.title.rendered}
            </div>
        </a>)}
    </div>
  </Main>

  <Footer />
</Layout>
