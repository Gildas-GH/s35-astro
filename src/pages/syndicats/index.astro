---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const syndicats = await getCollection("syndicats");

---

<Layout title={`Syndicats | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle="Syndicats" pageDesc=" L'Union Syndicale Solidaires est composée de fédérations et syndicats nationaux, qui se regroupent localement dans des Unions locales, départementales et régionales.">
    <div class="grid grid-cols-3 gap-4 my-4">
      {syndicats.map((p) => 
        <a href={`/syndicats/${p.id}/`} class="border-accent border-4 text-foreground hover:text-white hover:bg-accent transition font-bold flex flex-col gap-5 items-center text-center p-4 justify-between">
          {
            p.data.image && <img src={p.data.image} alt={`Logo de ${p.data.title}`} class="max-h-24"/>
          }
          <h3>{p.data.title}</h3>
        </a>
      )}
    </div>

  </Main>

  <Footer />
</Layout>
